<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1771354976195-1" author="mateusz gielczynski">
        <createTable tableName="question">
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="timestamp"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="question_pkey"/>
            </column>
            <column name="question" type="VARCHAR(255)"/>
            <column name="answers" type="VARCHAR(255) []"/>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-2" author="mateusz gielczynski">
        <createTable tableName="vote">
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="timestamp"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="group_id" type="uuid"/>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="vote_pkey"/>
            </column>
            <column name="question_id" type="uuid"/>
            <column name="voting_id" type="uuid"/>
            <column name="answer" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-3" author="mateusz gielczynski">
        <createTable tableName="vote_ability">
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="timestamp"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="vote_ability_pkey"/>
            </column>
            <column name="question" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="voting_id" type="uuid"/>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-4" author="mateusz gielczynski">
        <createTable tableName="voting">
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="timestamp"/>
            <column name="lock_time" type="timestamp"/>
            <column name="modified_at" type="timestamp"/>
            <column name="start_time" type="timestamp"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="voting_pkey"/>
            </column>
            <column name="owner" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-5" author="mateusz gielczynski">
        <createTable tableName="voting_group">
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="timestamp"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="voting_group_pkey"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="voters" type="UUID[]"/>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-6" author="mateusz gielczynski">
        <createTable tableName="voting_questions">
            <column name="questions_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="voting_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-7" author="mateusz gielczynski">
        <createTable tableName="voting_result">
            <column name="vote_count" type="FLOAT">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="voting_result_pkey"/>
            </column>
            <column name="question_id" type="uuid"/>
            <column name="voting_id" type="uuid"/>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-8" author="mateusz gielczynski">
        <createTable tableName="voting_result_option">
            <column name="count" type="FLOAT">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="voting_result_option_pkey"/>
            </column>
            <column name="option" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-9" author="mateusz gielczynski">
        <createTable tableName="voting_result_results">
            <column name="results_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="voting_result_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-10" author="mateusz gielczynski">
        <createTable tableName="voting_voting_groups">
            <column name="voting_groups_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="voting_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1771354976195-11" author="mateusz gielczynski">
        <addUniqueConstraint columnNames="questions_id" constraintName="voting_questions_questions_id_key"
