<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>pl.lodz.p.it.mateusz.gielczynski</groupId>
    <artifactId>Praca</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <modules>
        <module>Exceptions</module>
        <module>Loggers</module>
        <module>VotingEngine</module>
        <module>SecurityClient</module>
        <module>UserService</module>
        <module>VotingService</module>
        <module>EstateService</module>
        <module>NotificationService</module>
    </modules>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pl.lodz.p.it.mateusz.gielczynski</groupId>
                <artifactId>Exceptions</artifactId>
                <version>0.0.1-SNAPSHOT</version>
                <scope>compile</scope>
            </dependency>
            <dependency>
                <groupId>pl.lodz.p.it.mateusz.gielczynski</groupId>
                <artifactId>Loggers</artifactId>
                <version>0.0.1-SNAPSHOT</version>
                <scope>compile</scope>
            </dependency>
            <dependency>
                <groupId>pl.lodz.p.it.mateusz.gielczynski</groupId>
                <artifactId>VotingEngine</artifactId>
                <version>0.0.1-SNAPSHOT</version>
                <scope>compile</scope>
            </dependency>
            <dependency>
                <groupId>pl.lodz.p.it.mateusz.gielczynski</groupId>
                <artifactId>SecurityClient</artifactId>
                <version>0.0.1-SNAPSHOT</version>
                <scope>compile</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>install</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <inherited>false</inherited>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>install</phase>
                        <goals>
                            <goal>report-only</goal>
                        </goals>
                        <inherited>false</inherited>
                        <configuration>
                            <linkXRef>false</linkXRef>
                            <reportsDirectories>
                                <reportsDirectory>${project.basedir}/Exceptions/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/Loggers/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/VotingEngine/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/SecurityClient/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/UserService/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/VotingService/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/EstateService/target/surefire-reports</reportsDirectory>
                                <reportsDirectory>${project.basedir}/NotificationService/target/surefire-reports</reportsDirectory>
                            </reportsDirectories>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <aggregate>true</aggregate>
                </configuration>
            </plugin>
        </plugins>
    </reporting>


</project>
