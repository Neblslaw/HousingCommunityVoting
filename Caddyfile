localhost {
    handle_path /api/* {
        reverse_proxy user-service:8080
    }

    handle_path /voting-api/* {
        reverse_proxy voting-service:9090
    }

    handle_path /estate-api/* {
        reverse_proxy estate-service:9191
    }

    handle_path /notification-api/* {
        reverse_proxy notification-service:9292 {
            # Disables buffering so SSE streams instantly to the browser
            flush_interval -1
        }
    }

    # 5. WebSockets
    handle /votes* {
        @hasToken query token=*
        request_header @hasToken Authorization "Bearer {query.token}"
        rewrite * {path}
        reverse_proxy voting-service:9090
    }

    handle {
        reverse_proxy voting-front:5173
    }
}